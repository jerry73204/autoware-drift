<?xml version="1.0"?>
<package format="3">
  <name>drift_controller</name>
  <version>0.1.0</version>
  <description>The drift sequence (trail-brake, power-over, sideslip and yaw-rate hold, exit) that takes Autoware's control command near each drift waypoint and hands it back</description>
  <maintainer email="jerry73204@gmail.com">aeon</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>autoware_adapi_v1_msgs</exec_depend>
  <exec_depend>autoware_control_msgs</exec_depend>
  <exec_depend>autoware_planning_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
