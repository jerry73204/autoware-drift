<?xml version="1.0"?>
<package format="3">
  <name>race_planner_ros</name>
  <version>0.1.0</version>
  <description>The race planner (L1 re-planning, L2 tracking) as an Autoware node: Autoware's trajectory and the trajectory follower's control command, from race_planner's JSON-lines process</description>
  <maintainer email="jerry73204@gmail.com">aeon</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>autoware_adapi_v1_msgs</exec_depend>
  <exec_depend>autoware_control_msgs</exec_depend>
  <exec_depend>autoware_planning_msgs</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
